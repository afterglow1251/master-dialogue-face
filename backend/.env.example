# Server
PORT=3000

# Database
DATABASE_URL=postgresql://facial_user:facial_pass@localhost:5432/facial_expressions

# Clerk auth
CLERK_SECRET_KEY=sk_test_...
CLERK_PUBLISHABLE_KEY=pk_test_...

# NLP service
NLP_SERVICE_URL=http://localhost:8000
NLP_ANALYZE_TIMEOUT_MS=10000
NLP_HEALTH_TIMEOUT_MS=5000

# WebSocket
WS_DEFAULT_CONTEXT_WINDOW_SIZE=3
WS_DEFAULT_EXPRESSION_INTENSITY=1.0
WS_MAX_CONTEXT_WINDOW_SIZE=10
WS_MAX_EXPRESSION_INTENSITY=2.0

# Mood model (ALMA-based emotional state)
MOOD_DEFAULT_REACTIVITY=0.3
MOOD_DEFAULT_DECAY_SECONDS=300
MOOD_DEFAULT_EMOTION_WEIGHT=0.7
MOOD_MAX_DECAY_SECONDS=3600
