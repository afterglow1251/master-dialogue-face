# Server
PORT=3000

# Database
DATABASE_URL=postgresql://facial_user:facial_pass@localhost:5432/facial_expressions

# Clerk auth
CLERK_SECRET_KEY=sk_test_...
CLERK_PUBLISHABLE_KEY=pk_test_...

# Emotion model (Hugging Face Inference Providers)
HF_TOKEN=hf_...
HF_EMOTION_MODEL=SamLowe/roberta-base-go_emotions
HF_EMOTION_TIMEOUT_MS=15000

# LLM (Anthropic)
ANTHROPIC_API_KEY=sk-ant-...
LLM_MODEL=claude-haiku-4-5
LLM_MAX_TOKENS=2048
LLM_HISTORY_TURNS=20

# Text-to-speech (ElevenLabs)
ELEVENLABS_API_KEY=sk_...
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
ELEVENLABS_MODEL_ID=eleven_flash_v2_5
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_64
ELEVENLABS_TIMEOUT_MS=20000

# WebSocket
WS_DEFAULT_EXPRESSION_INTENSITY=1.0
WS_MAX_EXPRESSION_INTENSITY=2.0
WS_MAX_CHAT_TEXT_LENGTH=2000

# Expression composition: linear (emotion template mixture) or facs (Action Units)
EXPRESSION_MODE=facs

# Mood model (ALMA-based emotional state)
MOOD_DEFAULT_REACTIVITY=0.3
MOOD_DEFAULT_DECAY_SECONDS=300
MOOD_DEFAULT_EMOTION_WEIGHT=0.7
MOOD_MAX_DECAY_SECONDS=3600
